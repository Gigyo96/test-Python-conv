# Credenziali Google (necessarie dalla milestone M3 in poi; M1 e M2 girano senza)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Modelli: nessun nome e' hardcoded nel codice
IELTS_MODEL_FAST=
IELTS_MODEL_STRONG=

# Voce dell'esaminatore (en-GB, stabile per tutta la sessione)
IELTS_VOICE=
